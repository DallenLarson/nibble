<Window x:Class="Nibble.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Nibble.Controls"
        Title="Set up Nibble" Width="680" Height="690" ResizeMode="NoResize"
        WindowStyle="None" Background="{DynamicResource WindowBg}"
        WindowStartupLocation="CenterScreen" Icon="/Assets/nibble.png"
        FontFamily="{StaticResource UIFont}" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource HairlineStrong}" BorderThickness="1"
            Background="{DynamicResource WindowBg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
                <RowDefinition Height="86" />
            </Grid.RowDefinitions>

            <!-- header / drag handle -->
            <Grid x:Name="HeaderRow" Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0"
                            IsHitTestVisible="False">
                    <Image Source="/Assets/nibble-wordmark.png" Height="26" Stretch="Uniform"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="HeaderLabel" Text="N I B B L E" FontFamily="{StaticResource PixelFont}"
                               FontSize="10" Margin="11,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Ink}" />
                </StackPanel>

                <Button x:Name="SkipButton" Style="{StaticResource GhostButton}" Content="Skip"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                        Height="32" MinWidth="78" Click="Skip_Click" />
            </Grid>

            <!-- progress blocks -->
            <StackPanel x:Name="ProgressPanel" Grid.Row="1" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />

            <!-- step surface -->
            <Grid x:Name="StepHost" Grid.Row="2" Margin="40,6,40,0" ClipToBounds="True" />

            <!-- footer -->
            <Grid Grid.Row="3" Margin="40,0,40,0">
                <Button x:Name="BackButton" Style="{StaticResource GhostButton}" Content="Back"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Width="108"
                        Click="Back_Click" />
                <Button x:Name="NextButton" Style="{StaticResource PrimaryButton}" Content="Next"
                        HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="186"
                        Click="Next_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
